{
  "name": "infinitynotex",
  "private": true,
  "version": "1.0.7",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run electron:build",
    "web:build": "tsc && vite build",
    "electron:build:all": "bash scripts/build-all.sh --all",
    "electron:build:mac": "npm run web:build && electron-builder --mac",
    "electron:build:win": "npm run web:build && electron-builder --win",
    "electron:build:linux": "npm run web:build && electron-builder --linux",
    "electron:build": "bash scripts/build-all.sh",
    "build:all": "bash scripts/build-all.sh --all",
    "lint": "eslint . --ext ts,tsx --report-unused-disable-directives",
    "lint:fix": "eslint . --ext ts,tsx --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check",
    "prepare": "husky",
    "preview": "vite preview",
    "clean:release": "zsh ./clean-release.sh",
    "test": "vitest",
    "test:ui": "vitest --ui",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "rebuild": "electron-rebuild -f -w better-sqlite3,sqlite-vec",
    "postinstall": "electron-rebuild -f -w better-sqlite3,sqlite-vec"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^12.5.0",
    "bindings": "^1.5.0",
    "electron-log": "^5.4.3",
    "electron-updater": "^6.6.2",
    "file-uri-to-path": "^2.0.0",
    "sqlite-vec": "^0.1.7-alpha.2",
    "uuid": "^13.0.0",
    "webdav": "^5.8.0",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@ant-design/icons": "^5.0.0",
    "@ant-design/x": "^2.1.0",
    "@ant-design/x-markdown": "^2.1.0",
    "@ant-design/x-sdk": "^2.1.1",
    "@electron/rebuild": "^4.0.2",
    "@floating-ui/react": "^0.27.16",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-popover": "^1.1.15",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@tiptap/core": "^3.14.0",
    "@tiptap/extension-bubble-menu": "^3.13.0",
    "@tiptap/extension-character-count": "^3.13.0",
    "@tiptap/extension-code-block-lowlight": "^3.13.0",
    "@tiptap/extension-color": "^3.13.0",
    "@tiptap/extension-details": "^3.13.0",
    "@tiptap/extension-dropcursor": "^3.13.0",
    "@tiptap/extension-floating-menu": "^3.13.0",
    "@tiptap/extension-highlight": "^3.14.0",
    "@tiptap/extension-horizontal-rule": "^3.14.0",
    "@tiptap/extension-image": "^3.14.0",
    "@tiptap/extension-link": "^3.13.0",
    "@tiptap/extension-list": "^3.14.0",
    "@tiptap/extension-placeholder": "^3.13.0",
    "@tiptap/extension-subscript": "^3.14.0",
    "@tiptap/extension-superscript": "^3.14.0",
    "@tiptap/extension-table": "^3.13.0",
    "@tiptap/extension-task-item": "^3.13.0",
    "@tiptap/extension-task-list": "^3.13.0",
    "@tiptap/extension-text-align": "^3.14.0",
    "@tiptap/extension-text-style": "^3.13.0",
    "@tiptap/extension-typography": "^3.14.0",
    "@tiptap/extension-underline": "^3.13.0",
    "@tiptap/extensions": "^3.14.0",
    "@tiptap/html": "^3.13.0",
    "@tiptap/markdown": "^3.13.0",
    "@tiptap/pm": "^3.14.0",
    "@tiptap/react": "^3.14.0",
    "@tiptap/starter-kit": "^3.14.0",
    "@tiptap/suggestion": "^3.13.0",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.13",
    "@types/lodash.throttle": "^4.1.9",
    "@types/react": "^18.2.64",
    "@types/react-dom": "^18.2.21",
    "@types/uuid": "^11.0.0",
    "@typescript-eslint/eslint-plugin": "^7.1.1",
    "@typescript-eslint/parser": "^7.1.1",
    "@vitejs/plugin-react": "latest",
    "@vitest/coverage-v8": "^2.1.9",
    "@vitest/ui": "^2.1.9",
    "@xyflow/react": "^12.10.0",
    "antd": "^6.0.0",
    "dayjs": "^1.11.19",
    "electron": "^30.0.1",
    "electron-builder": "^24.13.3",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.5",
    "happy-dom": "^20.0.11",
    "highlight.js": "^11.0.0",
    "husky": "^9.1.7",
    "jsdom": "^27.2.0",
    "lint-staged": "^15.5.2",
    "lodash.throttle": "^4.1.1",
    "lowlight": "^3.3.0",
    "lucide-react": "^0.556.0",
    "prettier": "^3.6.2",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-hotkeys-hook": "^5.2.1",
    "rollup-plugin-visualizer": "^6.0.5",
    "sass-embedded": "^1.97.1",
    "tippy.js": "^6.3.7",
    "typescript": "^5.2.2",
    "vite": "^7.2.7",
    "vite-plugin-electron": "^0.28.6",
    "vite-plugin-electron-renderer": "^0.14.5",
    "vitest": "^2.1.9",
    "zustand": "^5.0.9"
  },
  "main": "dist-electron/main.js",
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md}": [
      "prettier --write"
    ]
  }
}
