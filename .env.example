# InfinityNoteX environment template
# Copy to .env for local development/release only.

# Optional: override auto-update feed URL (generic provider)
# Example: https://your-domain.com/infinitynotex/releases
INFINITY_UPDATER_URL=

# Optional: auto-update polling intervals (milliseconds)
INFINITY_UPDATER_INITIAL_DELAY_MS=15000
INFINITY_UPDATER_INTERVAL_MS=21600000

# Optional: local publish token for electron-builder
# Do not commit real values.
GH_TOKEN=
